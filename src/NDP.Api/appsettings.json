{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=ndp.db"
  },
  "Jwt": {
    "SecretKey": "your-secret-key-here-change-in-production",
    "Issuer": "NDP",
    "Audience": "NDP-Users",
    "ExpiryInDays": 365
  },
  "Books": {
    "EnableSoftDelete": true,
    "DefaultPageSize": 12,
    "MaxPageSize": 100
  },
  "Identity": {
    "RequireEmailConfirmation": false,
    "RequirePhoneConfirmation": false,
    "MaxLoginAttempts": 5
  },
  "Audits": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "Hits": {
    "EnableHitTracking": true
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 60
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
